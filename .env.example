# Database
POSTGRES_PASSWORD=troque-por-uma-senha-forte
DATABASE_URL=postgresql://luxus:troque-por-uma-senha-forte@localhost:5432/luxus_parceiros?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outra-chave-aleatoria-com-no-minimo-32-caracteres
JWT_REFRESH_EXPIRES_IN=7d

# API
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8081

# Web
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_WS_URL=http://localhost/events
EXPO_PUBLIC_API_URL=http://SEU-IP-LOCAL:3001
EXPO_PUBLIC_WS_URL=http://SEU-IP-LOCAL:3001/events

# Seed de dados demo: desligado por padrão. Para ligar em ambiente local/homologação,
# defina RUN_DB_SEED=true e uma SEED_ADMIN_PASSWORD forte (mín. 12 caracteres).
# Como a imagem roda com NODE_ENV=production, o seed também exige SEED_ALLOW_PRODUCTION=true.
RUN_DB_SEED=false
SEED_ADMIN_PASSWORD=
SEED_ALLOW_PRODUCTION=false

# Proxies confiáveis à frente da API (Railway = 1; Nginx + Cloudflare = 2).
TRUST_PROXY=1

# Swagger em /api/docs (desligado em produção, a menos que ENABLE_SWAGGER=true).
ENABLE_SWAGGER=false

# Endereço público do web, usado no link de redefinição de senha.
APP_URL=http://localhost:3000

# E-mail (redefinição de senha). Sem SMTP_HOST, o link só é registrado no log da API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Somente homologação: registra o link de redefinição no log da API quando não há SMTP.
MAIL_LOG_LINKS=false

# Upload
UPLOAD_MAX_SIZE=52428800
UPLOAD_DIR=./uploads

# Rate Limit
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Integração servidor-a-servidor com o Luxus Task.
# Use a mesma chave longa e aleatória nos dois sistemas.
LUXUS_TASK_API_URL=http://localhost:4000
LUXUS_TASK_INTEGRATION_KEY=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres
# Render gratuito pode precisar de mais tempo para acordar (padrão: 90000 ms).
LUXUS_TASK_TIMEOUT_MS=90000

# API de consulta de vendas para sistemas terceiros (header x-api-key).
EXTERNAL_SALES_API_KEY=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres

# Envio da venda concluída para o telefonia-2.
# Sem URL ou chave, a venda continua concluída e o envio fica aguardando.
# A URL pode ser só a origem. O caminho /v1/intake/customers é acrescentado.
TELEFONIA_INTAKE_URL=
TELEFONIA_INTAKE_API_KEY=
TELEFONIA_INTAKE_TIMEOUT_MS=90000
